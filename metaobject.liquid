{% assign metaobject = section.settings.metaobject %}

<section
  id="SatyMetaobject-{{ section.id }}"
  class="saty-metaobject"
>
  <div class="saty-metaobject-container">

    {% if metaobject.fulld != blank %}

      <div class="saty-store-grid">

        {% for item in metaobject.fulld.value %}

          <article class="saty-store-card">

            {% if item.name.value != blank %}
              <h2 class="saty-store-name">
                {{ item.name.value }}
              </h2>
            {% endif %}

            <div class="saty-store-details">

              {% if item.city.value != blank %}
                <div class="saty-store-detail">
                  <span class="saty-store-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path
                        d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                      <circle
                        cx="12"
                        cy="9"
                        r="2.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                    </svg>
                  </span>

                  <div>
                    <span class="saty-store-label">City</span>
                    <span class="saty-store-value">
                      {{ item.city.value }}
                    </span>
                  </div>
                </div>
              {% endif %}


              {% if item.address.value != blank %}
                <div class="saty-store-detail">
                  <span class="saty-store-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path
                        d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9.5Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M9 21v-6h6v6"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>

                  <div>
                    <span class="saty-store-label">Address</span>
                    <span class="saty-store-value">
                      {{ item.address.value }}
                    </span>
                  </div>
                </div>
              {% endif %}


              {% if item.phone.value != blank %}
                <div class="saty-store-detail">
                  <span class="saty-store-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path
                        d="M7.2 3.5 9.8 3c.6-.1 1.2.2 1.4.8l1.1 2.7c.2.5.1 1-.3 1.4L10.5 9.4a14.4 14.4 0 0 0 4.1 4.1l1.5-1.5c.4-.4.9-.5 1.4-.3l2.7 1.1c.6.2.9.8.8 1.4l-.5 2.6c-.1.7-.7 1.2-1.4 1.2C11.4 18 6 12.6 6 4.9c0-.7.5-1.3 1.2-1.4Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>

                  <div>
                    <span class="saty-store-label">Phone</span>
                    <a
                      class="saty-store-value saty-store-phone"
                      href="tel:{{ item.phone.value | escape }}"
                    >
                      {{ item.phone.value }}
                    </a>
                  </div>
                </div>
              {% endif %}

            </div>

          </article>

        {% endfor %}

      </div>

    {% else %}

      {% if request.design_mode %}
        <div class="saty-metaobject-empty">
          Select a metaobject from the section settings.
        </div>
      {% endif %}

    {% endif %}

  </div>
</section>



<style>
  #SatyMetaobject-{{ section.id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
    background: #f7f8fa;
  }

  #SatyMetaobject-{{ section.id }} .saty-metaobject-container {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }


  /* ========================================
     STORE GRID
  ======================================== */

  #SatyMetaobject-{{ section.id }} .saty-store-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
  }


  /* ========================================
     STORE CARD
  ======================================== */

  #SatyMetaobject-{{ section.id }} .saty-store-card {
    position: relative;
    padding: 28px;
    background: #ffffff;
    border: 1px solid #e8eaed;
    border-radius: 18px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    box-sizing: border-box;

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  #SatyMetaobject-{{ section.id }} .saty-store-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(
      90deg,
      #111827,
      #4b5563
    );
  }

  #SatyMetaobject-{{ section.id }} .saty-store-card:hover {
    transform: translateY(-5px);
    border-color: #d8dce2;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.09);
  }


  /* ========================================
     STORE NAME
  ======================================== */

  #SatyMetaobject-{{ section.id }} .saty-store-name {
    margin: 0 0 24px;
    padding-bottom: 18px;

    font-size: 24px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.4px;

    color: #17191c;

    border-bottom: 1px solid #eceef1;
  }


  /* ========================================
     STORE DETAILS
  ======================================== */

  #SatyMetaobject-{{ section.id }} .saty-store-details {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }


  /* ========================================
     DETAIL ROW
  ======================================== */

  #SatyMetaobject-{{ section.id }} .saty-store-detail {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    min-width: 0;
  }


  /* ========================================
     ICON
  ======================================== */

  #SatyMetaobject-{{ section.id }} .saty-store-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 40px;
    width: 40px;
    height: 40px;

    border-radius: 11px;
    background: #f1f3f5;
    color: #30343a;

    box-sizing: border-box;
  }

  #SatyMetaobject-{{ section.id }} .saty-store-icon svg {
    width: 20px;
    height: 20px;
    display: block;
  }


  /* ========================================
     LABEL + VALUE
  ======================================== */

  #SatyMetaobject-{{ section.id }} .saty-store-detail > div {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    padding-top: 1px;
  }

  #SatyMetaobject-{{ section.id }} .saty-store-label {
    display: block;

    font-size: 11px;
    line-height: 1.3;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;

    color: #8a9099;
  }

  #SatyMetaobject-{{ section.id }} .saty-store-value {
    display: block;

    font-size: 15px;
    line-height: 1.55;
    font-weight: 500;

    color: #292d33;
    overflow-wrap: anywhere;
  }


  /* ========================================
     PHONE
  ======================================== */

  #SatyMetaobject-{{ section.id }} .saty-store-phone {
    color: #20242a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #SatyMetaobject-{{ section.id }} .saty-store-phone:hover {
    color: #000000;
    text-decoration: underline;
  }


  /* ========================================
     EMPTY STATE
  ======================================== */

  #SatyMetaobject-{{ section.id }} .saty-metaobject-empty {
    width: 100%;
    padding: 40px 25px;

    text-align: center;

    background: #ffffff;
    border: 1px dashed #cfd3d8;
    border-radius: 16px;

    color: #666;
    font-size: 15px;
    line-height: 1.5;

    box-sizing: border-box;
  }


  /* ========================================
     TABLET
  ======================================== */

  @media screen and (max-width: 1100px) {
    #SatyMetaobject-{{ section.id }} .saty-store-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    #SatyMetaobject-{{ section.id }} .saty-store-card {
      padding: 24px;
    }

    #SatyMetaobject-{{ section.id }} .saty-store-name {
      font-size: 22px;
    }
  }


  /* ========================================
     MOBILE
  ======================================== */

  @media screen and (max-width: 749px) {
    #SatyMetaobject-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top }}px * 0.75);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
    }

    #SatyMetaobject-{{ section.id }} .saty-metaobject-container {
      padding-left: 15px;
      padding-right: 15px;
    }

    #SatyMetaobject-{{ section.id }} .saty-store-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #SatyMetaobject-{{ section.id }} .saty-store-card {
      padding: 22px;
      border-radius: 16px;
    }

    #SatyMetaobject-{{ section.id }} .saty-store-name {
      margin-bottom: 20px;
      padding-bottom: 15px;
      font-size: 21px;
    }

    #SatyMetaobject-{{ section.id }} .saty-store-details {
      gap: 15px;
    }

    #SatyMetaobject-{{ section.id }} .saty-store-value {
      font-size: 14px;
    }
  }


  /* ========================================
     SMALL MOBILE
  ======================================== */

  @media screen and (max-width: 480px) {
    #SatyMetaobject-{{ section.id }} .saty-metaobject-container {
      padding-left: 12px;
      padding-right: 12px;
    }

    #SatyMetaobject-{{ section.id }} .saty-store-card {
      padding: 19px;
    }

    #SatyMetaobject-{{ section.id }} .saty-store-name {
      font-size: 20px;
    }

    #SatyMetaobject-{{ section.id }} .saty-store-icon {
      flex-basis: 36px;
      width: 36px;
      height: 36px;
      border-radius: 10px;
    }

    #SatyMetaobject-{{ section.id }} .saty-store-icon svg {
      width: 18px;
      height: 18px;
    }
  }
</style>

{% schema %}
{
  "name": "Saty Metaobject",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "metaobject",
      "id": "metaobject",
      "label": "Select metaobject",
      "metaobject_type": "all_store_data"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Saty Metaobject"
    }
  ]
}
{% endschema %}


